    {
      "id": "R19",
      "category": "routage",
      "type": "route",
      "note": "push-to-talk pendant que Michel parle : « stop » coupe la voix",
      "directTo": "main",
      "speaking": true,
      "text": "Stop",
      "expect": {
        "kind": "stop"
      }
    },
    {
      "id": "M01",
      "category": "délégation",
      "type": "agent",
      "agent": "main",
      "text": "Combien font 17 fois 23 ?",
      "expect": {
        "noDelegation": true,
        "answerMatches": "391|trois cent quatre-vingt-onze",
        "approval": "none"
      }
    },
    {
      "id": "M02",
      "category": "délégation",
      "type": "agent",
      "agent": "main",
      "text": "Explique en deux phrases ce qu'est un trou noir.",
      "expect": {
        "noDelegation": true,
        "answerMatches": "lumière|gravit|masse",
        "approval": "none"
      }
    },
    {
      "id": "M03",
      "category": "délégation",
      "type": "agent",
      "agent": "main",
      "text": "Quel temps fait-il à Lyon aujourd'hui ?",

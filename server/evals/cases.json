        "kind": "ignored"
      }
    },
    {
      "id": "R17",
      "category": "routage",
      "type": "route",
      "note": "push-to-talk : sans prénom, la phrase va à Michel (en mains libres, R11 l'ignore)",
      "directTo": "main",
      "text": "Il faudrait penser à acheter du pain.",
      "expect": {
        "kind": "message",
        "agentId": "main"
      }
    },
    {
      "id": "R18",
      "category": "routage",
      "type": "route",

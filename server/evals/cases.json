{
  "_doc": "Agent evaluation cases (plan step 4). type \"route\": voice routing only (no model). type \"agent\": a message sent to an agent in its own test session; every approval request is refused by the runner. Expectations: kind/agentId (route); delegatesTo, notDelegatesTo, noDelegation, answerMatches, answerNotMatches (case-insensitive regex), noJsonBlock, approval (\"none\" | \"requested\"), approvalMatches, maxApprovals, fileUnchanged.",
  "cases": [
    {
      "id": "R01",
      "category": "routage",
      "type": "route",
      "text": "Michel, bonjour",
      "expect": {
        "kind": "wake",
        "agentId": "main"
      }
    },
    {
      "id": "R02",
      "category": "routage",
      "type": "route",
      "text": "Michel Explore, cherche la météo de demain",

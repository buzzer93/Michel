          "implementer"
        ],
        "approval": "none"
      }
    },
    {
      "id": "M07",
      "category": "délégation",
      "type": "agent",
      "agent": "main",
      "text": "Lis le fichier project/README.md et dis-moi en une phrase de quoi parle le projet.",

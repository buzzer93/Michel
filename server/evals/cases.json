        "answerMatches": "(\\d|un|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|quinze|vingt)[^.]{0,12}(n(œ|oe)uds?|kts)",
        "answerNotMatches": "pas pu|impossible|inaccessible|indisponible",
        "approval": "none"
      }
    },
    {
      "id": "M10",
      "category": "délégation",
      "type": "agent",
      "agent": "main",
      "note": "mémoire : une préférence dite par l'utilisateur devient une proposition à valider (balise lue par le serveur)",

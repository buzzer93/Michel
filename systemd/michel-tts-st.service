[Unit]
Description=Michel - synthese vocale Supertonic 3 (Supertone, 10 voix natives)

[Service]
WorkingDirectory=@APP@
Environment=MICHEL_TTS_THREADS=4
# 16 diffusion steps (model default 8): cleaner voice and intonation, still fast on the CPU
Environment=MICHEL_SUPERTONIC_STEPS=16
ExecStart=@APP@/.venv/bin/python tts/supertonic_server.py 8182
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
